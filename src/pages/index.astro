---
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredProjects = [
  {
    title: '12-DOF Quadruped Robot',
    label: 'Locomotion · ROS 2 · Mechanical design',
    description: 'Designed and built an 8 kg electromechanical platform, derived analytic inverse kinematics, and developed its ROS 2 locomotion stack.',
    metrics: ['12 DOF', '8 kg', '0.3 m/s'],
    image: '/assets/images/projects/quadruped/featured.webp',
    href: '/projects/quadruped-robot/'
  },
  {
    title: 'Mars Rover Manipal',
    label: 'Leadership · Mechanisms · Manufacturing',
    description: 'Led mechanical design and manufacturing across the rover, from mechanisms and fabrication through integration and competition deployment.',
    metrics: ['2× IRC winner', '10 cm drill', 'Patent filed'],
    image: '/assets/images/projects/mars-rover/featured.webp',
    href: '/projects/mars-rover-manipal/'
  },
  {
    title: 'Az–El Satellite Tracker',
    label: 'Precision motion · ESP32 · GPredict',
    description: 'Engineered a mechanically balanced, dual-axis pointing system with coordinated embedded control and live satellite-tracking commands.',
    metrics: ['<1° accuracy', '±180° azimuth', '0–90° elevation'],
    image: '/assets/images/projects/satellite-tracker/featured.webp',
    href: '/projects/satellite-tracker/'
  }
];
---

<BaseLayout
  title="Vipul Dinesh | Robotics Engineer"
  description="Robotics engineer with experience in mechanical design, actuation, embedded firmware, ROS 2, manufacturing, and systems integration."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Robotics engineer · Graduating November 2026</p>
      <h1 id="hero-title">Robotics and Mechatronics Engineer</h1>
      <p class="hero-intro">
        Focused on robotics hardware and systems integration, with experience in
        mechanical design, actuation, embedded firmware, ROS 2, manufacturing, and validation.
      </p>
      <div class="hero-context">
        <span>MIT Manipal</span>
        <span>CGPA 9.68/10</span>
        <span>Based in India</span>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore projects</a>
        <a class="button button-secondary" href="/Vipul_Dinesh_Robotics_Engineer_Resume.pdf" target="_blank" rel="noreferrer">Download résumé</a>
      </div>
    </div>

    <div class="hero-gallery" aria-label="Robotics projects">
      <figure class="hero-image hero-image-main">
        <img src="/assets/images/projects/mars-rover/featured.webp" alt="Mars Rover Manipal in a field environment" />
        <figcaption>Mars Rover Manipal · Mechanical Head</figcaption>
      </figure>
      <figure class="hero-image hero-image-top">
        <img src="/assets/images/projects/quadruped/featured.webp" alt="12-DOF quadruped robot" />
        <figcaption>12-DOF quadruped</figcaption>
      </figure>
      <figure class="hero-image hero-image-bottom">
        <img src="/assets/images/projects/satellite-tracker/featured.webp" alt="Azimuth-elevation satellite tracker" />
        <figcaption>Precision tracking</figcaption>
      </figure>
    </div>
  </section>

  <section class="proof-strip" aria-label="Career highlights">
    <div><strong>2×</strong><span>International Rover Challenge winner</span></div>
    <div><strong>12-DOF</strong><span>Quadruped designed and built</span></div>
    <div><strong>02</strong><span>Patent applications</span></div>
    <div><strong>0.3 m/s</strong><span>Quadruped walking and trotting</span></div>
  </section>

  <section class="selected-work" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="eyebrow">Project work</p>
      <h2 id="work-title">Robotics Projects</h2>
      <p>Three projects covering mechanical design, embedded control, ROS 2, manufacturing, integration, and physical testing.</p>
    </div>

    <div class="project-list">
      {featuredProjects.map((project, index) => (
        <article class="project-card">
          <a class="project-image" href={project.href} aria-label={`View ${project.title} case study`}>
            <span class="project-number">0{index + 1}</span>
            <img src={project.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="project-arrow" aria-hidden="true">↗</span>
          </a>
          <div class="project-content">
            <p class="project-label">{project.label}</p>
            <h3><a href={project.href}>{project.title}</a></h3>
            <p>{project.description}</p>
            <ul class="metric-list" aria-label={`${project.title} metrics`}>
              {project.metrics.map((metric) => <li>{metric}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href="/projects/">View all projects <span aria-hidden="true">→</span></a>
  </section>

  <section class="experience" id="experience" aria-labelledby="experience-title">
    <div class="section-heading experience-heading">
      <p class="eyebrow">Engineering experience</p>
      <h2 id="experience-title">Engineering Experience</h2>
      <p>Work on physical robots, precision motion systems, manufacturing, integration, and hardware qualification.</p>
    </div>
    <div class="timeline">
      <article>
        <div class="timeline-marker"><span>01</span></div>
        <div class="timeline-role">
          <p>December 2025 – Present · Bengaluru</p>
          <h3>Mechatronics R&amp;D Intern</h3>
          <strong>GiftdMinds</strong>
        </div>
        <div class="timeline-detail">
          <p>Designed and built a 12-DOF quadruped, developed ROS 2 locomotion and engineered a full-sky satellite tracker with coordinated embedded motion control.</p>
          <span>Quadruped · Precision motion · Embedded systems</span>
        </div>
      </article>
      <article>
        <div class="timeline-marker"><span>02</span></div>
        <div class="timeline-role">
          <p>November 2022 – September 2025 · Manipal</p>
          <h3>Mechanical Design &amp; Manufacturing Head</h3>
          <strong>Mars Rover Manipal</strong>
        </div>
        <div class="timeline-detail">
          <p>Led rover mechanical design, manufacturing, integration and deployment through consecutive International Rover Challenge wins.</p>
          <span>Leadership · Mechanisms · Manufacturing</span>
        </div>
      </article>
    </div>
  </section>

  <section class="capabilities" aria-labelledby="capabilities-title">
    <div class="capabilities-intro">
      <p class="eyebrow">Engineering capabilities</p>
      <h2 id="capabilities-title">Technical Focus Areas</h2>
      <p>My experience spans mechanical, embedded, and robot-software development for integrated electromechanical systems.</p>
    </div>
    <div class="capability-grid">
      <article><span>01</span><h3>Mechanisms &amp; actuation</h3><p>Linkages, transmissions, motor sizing, load paths, tolerance analysis, CAD and FEA.</p><small>Shown in: Rover · Tracker · Quadruped</small></article>
      <article><span>02</span><h3>Embedded motion</h3><p>ESP32 and STM32 control, sensors, communication buses, non-blocking motion and power systems.</p><small>Shown in: Tracker · Quadruped</small></article>
      <article><span>03</span><h3>Robotics &amp; control</h3><p>ROS 2, inverse kinematics, gait sequencing, PID, Gazebo, RViz, Nav2 and SLAM.</p><small>Shown in: Quadruped · RHex</small></article>
      <article><span>04</span><h3>Integration &amp; validation</h3><p>Rapid prototyping, assembly, system bring-up, field iteration, and physical testing.</p><small>Shown in: Rover · Tracker · GiftdMinds</small></article>
    </div>
  </section>

  <section class="recognition" aria-labelledby="recognition-title">
    <div>
      <p class="eyebrow">Recognition</p>
      <h2 id="recognition-title">Education and Recognition</h2>
    </div>
    <dl>
      <div><dt>9.68/10</dt><dd>CGPA · Mechatronics Engineering</dd></div>
      <div><dt>2 years</dt><dd>Branch Topper · 2022–23 and 2023–24</dd></div>
      <div><dt>4 years</dt><dd>Top 5% Merit Scholarship</dd></div>
      <div><dt>2 filings</dt><dd>Patent applications in mobility and rover science</dd></div>
    </dl>
  </section>

  <section class="contact-band" aria-labelledby="contact-title">
    <p class="eyebrow">Open to robotics opportunities</p>
    <h2 id="contact-title">Open to Full-Time Robotics Roles</h2>
    <p>I am graduating in November 2026 and interested in robotics hardware, mechatronics R&amp;D, mechanical design, and systems-integration roles.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="mailto:vipuldinesh11@gmail.com">Email me</a>
      <a class="button button-secondary" href="https://www.linkedin.com/in/vipul-dinesh/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
    </div>
  </section>
</BaseLayout>
